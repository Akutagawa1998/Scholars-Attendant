{
  "name": "@scholars-attendant/paper-collector",
  "version": "2.0.0",
  "description": "Collect research papers and create optional Notion write-ups in OpenClaw.",
  "private": true,
  "type": "module",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.11.4",
      "minGatewayVersion": "2026.11.4"
    }
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src/*.ts",
    "skills/",
    "docs/images/",
    "scripts/install-codex-skills.sh"
  ],
  "scripts": {
    "test": "node --test tests/openclaw/*.test.ts",
    "install:codex-skills": "bash scripts/install-codex-skills.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akutagawa1998/Scholars-Attendant.git"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  }
}
