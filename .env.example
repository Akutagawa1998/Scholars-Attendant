# Notion Integration Token (required)
# Get yours at: https://www.notion.so/my-integrations
NOTION_API_TOKEN=your_notion_integration_token_here

# Or point to a file containing the token:
# NOTION_API_TOKEN_FILE=/path/to/token/file

# Optional: required only when OpenClaw API mode uses an OpenAI model
OPENAI_API_KEY=your_openai_api_key_here

# Optional provider keys for non-OpenAI API mode models
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
